# ===========================================
# 공통 인프라 환경변수
# ===========================================
# Timezone
TZ=Asia/Seoul

# MySQL Database
MYSQL_ROOT_PASSWORD={your_mysql_root_password}
MYSQL_DATABASE=aitime

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# MinIO Object Storage
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD={your_minio_password}
MINIO_CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://{your_domain}

# ===========================================
# Spring Profile
# ===========================================
SPRING_PROFILE=prod

# ===========================================
# Database Configuration
# ===========================================
DB_HOST=mysql
DB_PORT=3306
DB_NAME=aitime
DB_USERNAME=root
DB_PASSWORD={your_db_password}
DB_URL=jdbc:mysql://mysql:3306/aitime?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=5
DB_CONNECTION_TIMEOUT=30000

# ===========================================
# JPA Configuration
# ===========================================
# Options: create, create-drop, update, validate, none
JPA_DDL_AUTO=update

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2s

# ===========================================
# RabbitMQ Configuration
# ===========================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ===========================================
# JWT Configuration
# ===========================================
# Generate a secure random string for production
# Example: openssl rand -base64 32
JWT_SECRET={your_jwt_secret_key_minimum_32_characters}
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=1209600000

# ===========================================
# CoolSMS Configuration
# ===========================================
# Get your API credentials from https://console.coolsms.co.kr/
COOLSMS_API_KEY={your_coolsms_api_key}
COOLSMS_API_SECRET={your_coolsms_api_secret}
COOLSMS_FROM_NUMBER={your_registered_phone_number}

# ===========================================
# MinIO Configuration
# ===========================================
MINIO_ENDPOINT=https://{your_domain}
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY={your_minio_secret_key}
MINIO_BUCKET_NAME=aitime
MINIO_REGION=us-east-1
MINIO_MAX_FILE_SIZE=524288000
MINIO_KEY_EXPIRATION=60

# ===========================================
# LiveKit Configuration
# ===========================================
# Get your credentials from https://cloud.livekit.io/
LIVEKIT_URL=http://livekit-server:7880
LIVEKIT_API_KEY={your_livekit_api_key}
LIVEKIT_API_SECRET={your_livekit_api_secret}

# ===========================================
# AI Server Configuration
# ===========================================
AI_SERVER_URL=http://screening:8000
AI_SERVER_TIMEOUT=30000

# ===========================================
# Screening Configuration
# ===========================================
SCREENING_SESSION_TIMEOUT=3600000
SCREENING_MAX_DURATION=1800000

# ===========================================
# Server Configuration
# ===========================================
SERVER_MAX_CONNECTIONS=8192
SERVER_MAX_THREADS=200
SERVER_MIN_THREADS=10

# ===========================================
# Logging Configuration
# ===========================================
# Options: trace, debug, info, warn, error
LOG_LEVEL=info
APP_LOG_LEVEL=info
SQL_LOG_LEVEL=warn
SQL_BIND_LOG_LEVEL=warn