# 1) 빌드 스테이지
FROM eclipse-temurin:17-jdk AS build
WORKDIR /app

# gradle wrapper와 설정 먼저 복사(캐시 효율)
COPY gradlew .
COPY gradle gradle
COPY build.gradle* settings.gradle* ./

# 소스 복사
COPY src ./src

# 빌드
RUN chmod +x gradlew && ./gradlew clean bootJar -x test --stacktrace

# JAR 파일 위치 확인 및 복사를 위한 준비
RUN mkdir -p /app/target && \
    find /app/build/libs -name "*.jar" -not -name "*-plain.jar" -exec cp {} /app/target/app.jar \; && \
    ls -lh /app/target/

# 2) 런타임 스테이지
FROM eclipse-temurin:17-jre
WORKDIR /app

# 빌드 결과 jar 복사 (명확한 경로로)
COPY --from=build /app/target/app.jar app.jar

# 파일 확인
RUN ls -lh /app/

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "/app/app.jar"]