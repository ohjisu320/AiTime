# CPU 환경용 Dockerfile (Speech Imitation)
FROM python:3.11-slim

WORKDIR /app

# 시스템 패키지 설치 (오디오 처리 의존성)
RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libsndfile1 \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 의존성 설치
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 앱 복사
COPY app/ ./app/

# 환경 변수
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV DEVICE=cpu

# RabbitMQ 환경 변수 (docker-compose에서 오버라이드 가능)
ENV RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
ENV INPUT_QUEUE=analysis.req.task2
ENV OUTPUT_QUEUE=analysis.resp

# Health check용 포트
EXPOSE 8002

# 기본 명령어: Worker 실행
CMD ["python", "-m", "app.worker"]
