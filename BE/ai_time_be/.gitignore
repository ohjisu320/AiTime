############################################
# 1) Build & Dependency (빌드 산출물 제외)
############################################
.gradle/
build/
out/
bin/
/db/            # 로컬 DB 데이터 파일 등

############################################
# 2) IDE & Editor (개발 환경 파일 제외)
############################################
.idea/
*.iml
*.iws
*.ipr
.vscode/
.classpath
.project
.settings/

############################################
# 3) Security & Config (가장 중요한 부분)
############################################
# 모든 설정 파일 차단 (보안 유출 방지)
*.yml
*.yaml
*.properties
.env
.env.*

# 암호화 및 키 파일
*.key
*.pem
*.crt
*.p12
*.jks

# [예외 허용] 빌드에 필수적인 설정 파일은 다시 허용
!build.gradle
!settings.gradle
!gradle.properties

############################################
# 4) OS & Log (시스템 찌꺼기)
############################################
.DS_Store
Thumbs.db
*.log
logs/
tmp/

############################################
# 5) Java / Compiled (컴파일 결과물 제외)
############################################
*.class