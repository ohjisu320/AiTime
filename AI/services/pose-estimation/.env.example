# =============================================================================
# pose-estimation 환경 변수 설정
# =============================================================================
# 사용법: 이 파일을 .env로 복사하여 사용
# cp .env.example .env
# =============================================================================

# ===== 서버 설정 =====
APP_NAME=ViTPose Motion Analyzer
APP_VERSION=1.0.0
# 디버그 모드 활성화 (true/false)
DEBUG_MODE=false
# 로그 레벨: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ===== 디바이스 설정 =====
# 연산 장치: cuda, cpu, mps
DEVICE=cuda

# ===== 모델 설정 =====
# 사람 감지 모델 (HuggingFace ID)
PERSON_DETECTOR=PekingU/rtdetr_r50vd_coco_o365
# 자세 추정 모델 (HuggingFace ID)
POSE_MODEL=usyd-community/vitpose-base-simple

# ===== 영상 처리 설정 =====
# 프레임 추출 목표 FPS (1.0 ~ 60.0)
TARGET_FPS=10.0
# 최대 추출 프레임 수 (10 ~ 1000)
MAX_VIDEO_FRAMES=300
# 최대 영상 길이 (초)
MAX_VIDEO_DURATION_SEC=30.0
# 지원 영상 포맷 (쉼표 구분)
# SUPPORTED_VIDEO_FORMATS=.mp4,.webm,.avi,.mov

# ===== 자세 추정 설정 =====
# 기본 감지 신뢰도 임계값 (0.0 ~ 1.0)
DEFAULT_THRESHOLD=0.3
# 유효 키포인트 최소 점수
MIN_KEYPOINT_SCORE=0.1
# 유효 프레임 판정을 위한 최소 키포인트 수
MIN_VALID_KEYPOINTS=8
# 경고를 발생시킬 최소 유효 프레임 비율
MIN_VALID_FRAME_RATIO=0.1

# ===== 정규화 설정 =====
# 정규화 방식: torso, bbox, hip_center
NORMALIZATION_METHOD=torso
# 정규화 기준 높이
REFERENCE_HEIGHT=1.0

# ===== DTW 설정 =====
# DTW 거리 계산 방식: euclidean, cosine, manhattan
DTW_DISTANCE_METRIC=euclidean
# Sakoe-Chiba 윈도우 비율 (0.0 ~ 1.0, 0이면 제약 없음)
DTW_WINDOW_RATIO=0.1

# ===== 유사도 계산 설정 =====
# 신체 부위별 가중치
SIMILARITY_UPPER_BODY_WEIGHT=1.0
SIMILARITY_LOWER_BODY_WEIGHT=1.0
SIMILARITY_HEAD_WEIGHT=1.0

# ===== 동작별 판정 임계값 =====
# 각 동작의 통과 기준 (0.0 ~ 1.0)
THRESHOLD_CLAPPING=0.6
THRESHOLD_HURRAY=0.6
THRESHOLD_WALKING_BACK=0.6
THRESHOLD_JUMPING=0.6
THRESHOLD_KICKING=0.6
THRESHOLD_THROWING=0.6

# ===== 표정 분석 설정 (ADOS B6) =====
# 표정 분석 활성화 (true/false)
EMOTION_ENABLE=true
# 프레임 샘플링 간격 (매 N프레임 분석)
EMOTION_SKIP_FRAMES=5
# 최소 얼굴 크기 (픽셀)
EMOTION_MIN_FACE_SIZE=64
# 표정 인식 모델 이름
EMOTION_MODEL_NAME=enet_b0_8_best_vgaf
# ADOS B6 판정 임계값 (Happiness 비율 >= 이 값이면 B6=True)
EMOTION_JOY_THRESHOLD=0.1
# 얼굴 탐지 신뢰도 임계값
EMOTION_FACE_CONFIDENCE_THRESHOLD=0.9

# ===== RabbitMQ 설정 =====
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ===== 큐 설정 =====
TASK_QUEUE=pose_task_queue
RESULT_QUEUE=pose_result_queue
