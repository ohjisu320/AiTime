# =============================================================================
# name_non_facing 환경 변수 설정
# =============================================================================
# 사용법: 이 파일을 .env로 복사하여 사용
# cp .env.example .env
# =============================================================================

# ===== 실행 모드 =====
# worker: RabbitMQ Consumer (기본값)
# api: FastAPI Health Check 서버
RUN_MODE=

# ===== RabbitMQ 설정 =====
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=

# ===== 큐 설정 =====
INPUT_QUEUE=
OUTPUT_QUEUE=

# ===== 디바이스 설정 =====
# cuda: GPU 사용 (권장)
# cpu: CPU만 사용
DEVICE=
WHISPER_DEVICE=
DIARIZATION_DEVICE=
SIXDREPNET_DEVICE=

# ===== 모델 설정 =====
# YOLO Head 모델
# - yolo_p2layer_jh.pt: P2 layer 추가된 커스텀 모델 (뒤통수 탐지 개선)
# - yolov8n.pt: 일반 person detection (fallback)
YOLO_HEAD_MODEL=
YOLO_HEAD_CONFIDENCE=

# Whisper 모델 크기
# tiny, base, small, medium, large, large-v3
WHISPER_MODEL_SIZE=
WHISPER_LANGUAGE=ko
WHISPER_COMPUTE_TYPE=
WHISPER_BEAM_SIZE=
WHISPER_WORD_TIMESTAMPS=

# ===== HuggingFace 설정 =====
# pyannote 모델 다운로드용 인증 토큰
# https://huggingface.co/settings/tokens 에서 발급
DIARIZATION_USE_AUTH_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxx

# ===== VAD (Voice Activity Detection) 설정 =====
VAD_THRESHOLD=
VAD_MIN_SPEECH_DURATION_MS=
VAD_MIN_SILENCE_DURATION_MS=
VAD_WINDOW_SIZE_SAMPLES=
VAD_SPEECH_PAD_MS=

# ===== 화자 분리 설정 =====
DIARIZATION_MIN_SPEAKERS=1
DIARIZATION_MAX_SPEAKERS=2
DIARIZATION_MIN_SEGMENT_DURATION=

# ===== 반응 판정 설정 =====
# 반응 모드: gaze_only, voice_only, or, and, weighted
REACTION_MODE=
# 반응 대기 시간 (초)
REACTION_TIMEOUT_SEC=

# ===== 시선 분석 설정 =====
# 시선 벡터와 위치 벡터 간 각도 임계값 (도)
GAZE_ANGLE_THRESHOLD_DEG=
# 안정화 판정에 필요한 연속 프레임 수
GAZE_STABILIZE_FRAMES=
# 최소 시선 유지 시간 (초)
MIN_GAZE_DURATION_SEC=

# ===== 음성 반응 설정 =====
VOICE_REACTION_ENABLED=
# 최소 발화 시간 (초)
MIN_VOICE_DURATION_SEC=
# 음성 반응 신뢰도 임계값
VOICE_CONFIDENCE_THRESHOLD=

# ===== 비디오 처리 =====
# 분석용 FPS 샘플링 (0: 원본 FPS 유지)
VIDEO_FPS_SAMPLE=

# ===== 로깅 =====
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
DEBUG=false

# ===== 시각화 디버그 =====
# true로 설정 시 바운딩 박스, 시선 벡터 등 표시
ENABLE_VISUALIZATION_DEBUG=