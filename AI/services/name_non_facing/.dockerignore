# =============================================================================
# name_non_facing .dockerignore
# =============================================================================
# Docker 이미지 빌드 시 제외할 파일/폴더
# 이미지 크기 최소화 및 빌드 속도 향상
# =============================================================================

# --------------------------------------------------------------------
# [1] 환경 설정 및 보안 (Environment & Security)
# --------------------------------------------------------------------
# 환경 변수 파일 (런타임에 주입)
.env
.env.local
.env.prod
.env.example

# 인증서 및 키 파일
*.pem
*.key
*.crt
secrets/

# --------------------------------------------------------------------
# [2] 버전 관리 및 IDE (Version Control & IDE)
# --------------------------------------------------------------------
.git/
.gitignore
.gitattributes

.vscode/
.idea/
*.swp
*.swo
*~

# --------------------------------------------------------------------
# [3] Python 캐시 및 가상환경 (Python Cache & Virtual Env)
# --------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

.venv/
venv/
env/
.conda/

# 테스트/린팅 캐시
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/

# 빌드 산출물
*.egg-info/
*.egg
dist/
build/
wheels/

# --------------------------------------------------------------------
# [4] 문서 및 개발 자료 (Documentation & Dev Resources)
# --------------------------------------------------------------------
# 개발 문서
docs/

# README는 참조용이므로 제외
README.md
CHANGELOG.md
LICENSE

# --------------------------------------------------------------------
# [5] 테스트 (Tests)
# --------------------------------------------------------------------
tests/
test/
*_test.py
test_*.py
conftest.py

# HTTP 테스트 파일
*.http

# --------------------------------------------------------------------
# [6] 샘플 및 출력 파일 (Samples & Outputs)
# --------------------------------------------------------------------
# 샘플 비디오 (테스트용)
sample_video/

# 분석 출력 폴더
output/

# 디버그 시각화 결과
debug_*.mp4
*_debug.mp4

# --------------------------------------------------------------------
# [7] 미디어 파일 (Media Files)
# --------------------------------------------------------------------
# 비디오 파일 (대용량)
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.wmv
*.flv

# 이미지 파일 (출력물)
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.tiff

# 오디오 파일
*.mp3
*.wav
*.flac
*.aac

# --------------------------------------------------------------------
# [8] 모델 파일 (Model Files)
# --------------------------------------------------------------------
# 주의: models/ 폴더의 yolo_p2layer_jh.pt는 필요!
# 아래는 캐시/임시 모델 파일만 제외

# HuggingFace 캐시 (런타임에 다운로드)
.cache/
*.onnx
*.safetensors

# 6DRepNet 가중치 (자동 다운로드)
weights/

# TFLite 모델 (사용하지 않음)
*.tflite

# --------------------------------------------------------------------
# [9] 로그 및 임시 파일 (Logs & Temp Files)
# --------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
tmp/
temp/
nul

# --------------------------------------------------------------------
# [10] Docker/CI 관련 (Docker & CI)
# --------------------------------------------------------------------
# Docker Compose (빌드 불필요)
docker-compose*.yml

# CI/CD 설정
.github/
.gitlab-ci.yml
.travis.yml
Jenkinsfile
Makefile

# --------------------------------------------------------------------
# [11] 기타 (Miscellaneous)
# --------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# 백업 파일
*.bak
*.backup
*_backup.*

# 압축 파일
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# 임시 유틸리티
TEMP_utils/
